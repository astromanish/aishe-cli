#!/usr/bin/env python3
"""Aishe CLI — command-line interface for all Aishe Tauri app features.

Hits the same HTTP endpoints the desktop app uses:
  - DeepAgent  :8765  (chat, stream)
  - Ollama     :11434 (models)
  - Parakeet   :5093  (STT)
  - Supertonic :8766  (TTS)
  - File-based memory & threads at ~/Library/Application Support/aishe/

Usage:
  aishe status                 — check all services
  aishe chat "hello"           — one-shot chat (DeepAgent)
  aishe stream "hello"         — streaming chat (tokens printed live)
  aishe live                   — live voice conversation (press Enter to record)
  aishe live --list            — list mic devices
  aishe threads                — list all chat threads
  aishe threads --new          — create a new thread
  aishe threads --delete <id>  — delete a thread
  aishe threads --show <id>    — show thread messages
  aishe memory add "fact"      — add a memory
  aishe memory search "query"  — search memories
  aishe memory list            — list all memories
  aishe memory clear           — clear all memories
  aishe voice transcribe <wav> — transcribe audio file
  aishe voice speak "text"     — synthesize speech + play
  aishe voice speak "text" -o out.wav  — synthesize, save only
  aishe voice status           — check STT/TTS services
  aishe ollama models          — list pulled models
  aishe ollama pull <model>   — pull a model
  aishe ollama whoami          — check ollama login
  aishe intent stats [--days N]— intent lab stats
  aishe intent export          — export intent log as CSV

Requirements: Python 3.12+, requests (pip install requests)
"""

import argparse
import json
import os
import sys
import subprocess
import uuid
from datetime import datetime
from pathlib import Path

try:
    import requests
except ImportError:
    print("Error: 'requests' not installed. Run: pip install requests")
    sys.exit(1)

# ─── Config ────────────────────────────────────────────────────────────────

DEEPAGENT = "http://localhost:8765"
OLLAMA    = "http://localhost:11434"
STT       = "http://localhost:5093"
TTS       = "http://localhost:8766"

DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/Library/Application Support"))) / "aishe"
THREADS_DIR = DATA_DIR / "threads"
MEMORY_DIR  = DATA_DIR / "memory"
MEMORY_FILE = MEMORY_DIR / "facts.jsonl"
INTENT_DIR  = DATA_DIR / "intent_lab"

# ─── Helpers ───────────────────────────────────────────────────────────────

def ensure_dirs():
    THREADS_DIR.mkdir(parents=True, exist_ok=True)
    MEMORY_DIR.mkdir(parents=True, exist_ok=True)

def now_rfc3339():
    return datetime.now().isoformat()

def green(s):  return f"\033[32m{s}\033[0m"
def red(s):    return f"\033[31m{s}\033[0m"
def yellow(s): return f"\033[33m{s}\033[0m"
def cyan(s):   return f"\033[36m{s}\033[0m"
def bold(s):   return f"\033[1m{s}\033[0m"
def dim(s):    return f"\033[2m{s}\033[0m"

def check(url, timeout=3):
    try:
        r = requests.get(url, timeout=timeout)
        return r.status_code < 300
    except:
        return False

# ─── Status ────────────────────────────────────────────────────────────────

def cmd_status(args):
    services = [
        ("Ollama",      f"{OLLAMA}/api/tags"),
        ("DeepAgent",   f"{DEEPAGENT}/health"),
        ("Parakeet STT",f"{STT}/healthz"),
        ("Supertonic",  f"{TTS}/health"),
        ("Memory",      str(MEMORY_FILE)),
        ("Threads",     str(THREADS_DIR)),
    ]
    print(bold("Aishe Service Status"))
    print("─" * 50)
    for name, url in services:
        if url.startswith("http"):
            up = check(url)
            extra = ""
            if name == "Ollama" and up:
                try:
                    r = requests.get(f"{OLLAMA}/api/tags", timeout=3)
                    models = r.json().get("models", [])
                    extra = f" ({len(models)} models)"
                except: pass
            elif name == "Supertonic" and up:
                try:
                    r = requests.get(f"{TTS}/health", timeout=3)
                    j = r.json()
                    extra = f" (loaded={j.get('model_loaded', '?')})"
                except: pass
        else:
            up = Path(url).exists() or url.strip()
            extra = ""
        status = green("✓ UP") if up else red("✗ DOWN")
        print(f"  {name:16s} {status} {dim(extra)}")

    # Memory count
    if MEMORY_FILE.exists():
        count = sum(1 for line in MEMORY_FILE.read_text().splitlines() if line.strip())
        print(f"  {dim(f'Memory entries: {count}')}")
    # Threads count
    if THREADS_DIR.exists():
        count = len(list(THREADS_DIR.glob("*.json")))
        print(f"  {dim(f'Threads: {count}')}")

# ─── Chat ───────────────────────────────────────────────────────────────────

def cmd_chat(args):
    msg = " ".join(args.message) if isinstance(args.message, list) else args.message
    if not msg:
        msg = sys.stdin.read().strip()
    if not msg:
        print(red("No message provided")); sys.exit(1)

    tid = args.thread or "cli"
    try:
        r = requests.post(f"{DEEPAGENT}/invoke", json={"message": msg, "thread_id": tid}, timeout=120)
        r.raise_for_status()
        data = r.json()
    except requests.exceptions.ConnectionError:
        print(red("Cannot reach DeepAgent on :8765. Start it first:")); print(f"  cd aishe-tauri/deepagent && .venv/bin/python server.py")
        sys.exit(1)
    except Exception as e:
        print(red(f"Error: {e}")); sys.exit(1)

    print(data.get("answer", ""))
    if args.verbose:
        print(dim(f"\n─ stats: {data.get('steps', '?')} steps, {len(data.get('tool_calls', []))} tool calls"))
        for tc in data.get("tool_calls", []):
            print(dim(f"  tool: {tc['name']}({json.dumps(tc['args'], ensure_ascii=False)})"))

def cmd_stream(args):
    msg = " ".join(args.message) if isinstance(args.message, list) else args.message
    if not msg:
        msg = sys.stdin.read().strip()
    if not msg:
        print(red("No message provided")); sys.exit(1)

    tid = args.thread or "cli"
    try:
        r = requests.post(f"{DEEPAGENT}/stream", json={"message": msg, "thread_id": tid}, stream=True, timeout=120)
        r.raise_for_status()
    except requests.exceptions.ConnectionError:
        print(red("Cannot reach DeepAgent on :8765.")); sys.exit(1)

    answer = ""
    for line in r.iter_lines():
        if not line: continue
        try:
            ev = json.loads(line)
        except: continue
        etype = ev.get("event", "")
        if etype == "token":
            tok = ev.get("content", "")
            print(tok, end="", flush=True)
            answer += tok
        elif etype == "tool_call":
            print(yellow(f"\n  [tool: {ev.get('name', '?')}]"), flush=True)
        elif etype == "tool_result":
            print(dim(f"  [result: {ev.get('result', '')[:100]}]"), flush=True)
        elif etype == "final":
            if not answer:
                answer = ev.get("answer", "")
    if not answer:
        print(dim("(empty response)"))
    print()  # final newline

# ─── Threads ───────────────────────────────────────────────────────────────

def cmd_threads(args):
    ensure_dirs()
    if args.new:
        thread = {
            "id": f"thr_{uuid.uuid4().hex}",
            "title": "CLI Chat",
            "created_at": now_rfc3339(),
            "updated_at": now_rfc3339(),
            "messages": [],
        }
        path = THREADS_DIR / f"{thread['id']}.json"
        path.write_text(json.dumps(thread, indent=2))
        print(f"{green('Created')} {thread['id']}")
        return

    if args.delete:
        path = THREADS_DIR / f"{args.delete}.json"
        if path.exists():
            path.unlink()
            print(f"{red('Deleted')} {args.delete}")
        else:
            print(red(f"Thread {args.delete} not found"))
        return

    if args.show:
        path = THREADS_DIR / f"{args.show}.json"
        if not path.exists():
            print(red(f"Thread {args.show} not found")); sys.exit(1)
        thread = json.loads(path.read_text())
        print(bold(f"Thread: {thread['title']}"))
        print(dim(f"ID: {thread['id']}  Created: {thread['created_at']}"))
        print("─" * 50)
        for msg in thread["messages"]:
            role = msg["role"]
            content = msg["content"]
            if role == "user":
                print(cyan(f"You: {content}"))
            else:
                print(f"Aishe: {content}")
            print()
        return

    threads = []
    for f in THREADS_DIR.glob("*.json"):
        try:
            t = json.loads(f.read_text())
            threads.append(t)
        except: pass
    threads.sort(key=lambda t: t.get("updated_at", ""), reverse=True)

    if not threads:
        print(dim("No threads yet. Create one with: aishe threads --new"))
        return

    print(bold(f"Threads ({len(threads)})"))
    print("─" * 60)
    for t in threads:
        n_msgs = len(t.get("messages", []))
        title = t.get("title", "untitled")
        print(f"  {t['id']:40s} {title:20s} {dim(f'{n_msgs} msgs')}")

# ─── Memory ─────────────────────────────────────────────────────────────────

def cmd_memory(args):
    ensure_dirs()

    if args.action == "add":
        fact = " ".join(args.value) if isinstance(args.value, list) else args.value
        if not fact:
            fact = sys.stdin.read().strip()
        if not fact:
            print(red("No fact provided")); sys.exit(1)
        entry = {
            "id": f"mem_{uuid.uuid4().hex}",
            "fact": fact,
            "timestamp": now_rfc3339(),
        }
        with open(MEMORY_FILE, "a") as f:
            f.write(json.dumps(entry) + "\n")
        print(f"{green('Added')} {entry['id']}: {fact}")
        return

    if args.action == "search":
        query = " ".join(args.value) if isinstance(args.value, list) else args.value
        if not query:
            print(red("No query provided")); sys.exit(1)
        if not MEMORY_FILE.exists():
            print(dim("No memories stored.")); return
        ql = query.lower()
        results = []
        for line in MEMORY_FILE.read_text().splitlines():
            if not line.strip(): continue
            try:
                entry = json.loads(line)
            except: continue
            if entry["fact"].lower().find(ql) >= 0:
                results.append(entry)
        if results:
            print(bold(f"Found {len(results)} match(es):"))
            for r in results:
                print(f"  {cyan(r['id'])}  {r['fact']}")
                print(f"  {dim(r['timestamp'])}")
        else:
            print(dim("No matches found."))
        return

    if args.action == "list":
        if not MEMORY_FILE.exists():
            print(dim("No memories stored.")); return
        entries = []
        for line in MEMORY_FILE.read_text().splitlines():
            if line.strip():
                try: entries.append(json.loads(line))
                except: pass
        if not entries:
            print(dim("No memories stored.")); return
        print(bold(f"Memories ({len(entries)})"))
        print("─" * 60)
        for e in entries:
            print(f"  {cyan(e['id'])}  {e['fact']}")
            print(f"  {dim(e['timestamp'])}")
        return

    if args.action == "clear":
        if MEMORY_FILE.exists():
            count = sum(1 for l in MEMORY_FILE.read_text().splitlines() if l.strip())
            MEMORY_FILE.unlink()
            print(f"{red('Cleared')} {count} memories")
        else:
            print(dim("Nothing to clear"))
        return

# ─── Voice ─────────────────────────────────────────────────────────────────

def cmd_voice(args):
    if args.action == "status":
        stt = check(f"{STT}/healthz")
        tts_ok = check(f"{TTS}/health")
        print(bold("Voice Services"))
        print(f"  Parakeet STT  :5093  {green('✓ UP') if stt else red('✗ DOWN')}")
        print(f"  Supertonic TTS :8766  {green('✓ UP') if tts_ok else red('✗ DOWN')}")
        return

    if args.action == "transcribe":
        path = args.file
        if not path or not os.path.exists(path):
            print(red(f"Audio file not found: {path}")); sys.exit(1)
        try:
            with open(path, "rb") as f:
                resp = requests.post(
                    f"{STT}/v1/audio/transcriptions",
                    files={"file": (os.path.basename(path), f, "audio/wav")},
                    data={"model": "parakeet-tdt-0.6b-v3"},
                    timeout=30,
                )
            resp.raise_for_status()
        except requests.exceptions.ConnectionError:
            print(red("Cannot reach Parakeet STT on :5093")); sys.exit(1)
        text = resp.json().get("text", "")
        print(text)
        return

    if args.action == "speak":
        # Merge file (positional, may eat first word) + text (rest of words)
        parts = []
        if args.file:
            parts.append(args.file)
        if args.text:
            parts.extend(args.text)
        text = " ".join(parts)
        if not text:
            text = sys.stdin.read().strip()
        if not text:
            print(red("No text provided")); sys.exit(1)
        voice = args.voice or "F4"
        try:
            resp = requests.post(
                f"{TTS}/v1/audio/speech",
                json={"input": text, "voice": voice, "model": "supertonic-3", "response_format": "wav"},
                timeout=60,
            )
            resp.raise_for_status()
        except requests.exceptions.ConnectionError:
            print(red("Cannot reach Supertonic TTS on :8766")); sys.exit(1)
        if args.output:
            outpath = args.output
        else:
            outpath = f"/tmp/aishe_tts_{uuid.uuid4().hex[:8]}.wav"
        with open(outpath, "wb") as f:
            f.write(resp.content)
        print(f"{green('Synthesized')} {len(resp.content)} bytes → {outpath}")
        if not args.no_play:
            print(dim("Playing..."))
            subprocess.run(["afplay", outpath])
        return

# ─── Ollama ─────────────────────────────────────────────────────────────────

def cmd_ollama(args):
    if args.action == "models":
        try:
            r = requests.get(f"{OLLAMA}/api/tags", timeout=5)
            r.raise_for_status()
            models = r.json().get("models", [])
        except: print(red("Ollama not reachable on :11434")); sys.exit(1)
        if not models:
            print(dim("No models pulled. Use: aishe ollama pull <model>")); return
