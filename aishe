#!/usr/bin/env python3
"""Aishe CLI — voice-first AI assistant for your terminal.

A standalone command-line AI assistant with voice input/output,
persistent memory, chat threads, tool calling, and live voice
conversation — all from your terminal.

Usage:
  aishe status                 — check all services
  aishe chat "hello"           — one-shot chat
  aishe stream "hello"         — streaming chat (tokens printed live)
  aishe repl                   — continuous text REPL
  aishe live                   — live voice conversation
  aishe doctor                 — run diagnostics
  aishe search "query"         — search threads + memory
  aishe export                 — export all data
  aishe config                 — view/edit config
  aishe version                — show version
  aishe completions bash       — generate shell completions
  aishe threads                — manage threads
  aishe memory add "fact"      — manage memory
  aishe voice transcribe <wav> — voice I/O
  aishe ollama models          — Ollama management
  aishe intent stats           — intent lab

Requirements: Python 3.9+, requests (pip install requests)
"""

import os
import sys

# Add common Homebrew paths for external tools
os.environ["PATH"] = f"/opt/homebrew/bin:/usr/local/bin:{os.environ.get('PATH', '')}"

# Ensure the package directory is on the path
pkg_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "aishe_pkg")
if pkg_dir not in sys.path:
    sys.path.insert(0, os.path.dirname(pkg_dir))

# Suppress noisy urllib3 warning on older macOS Python
import warnings
warnings.filterwarnings("ignore", category=Warning, module="urllib3")
warnings.filterwarnings("ignore", message=".*NotOpenSSLWarning.*")

try:
    from aishe_pkg.cli import main
except ImportError as e:
    print(f"Error: Failed to load aishe package: {e}", file=sys.stderr)
    print("Make sure aishe_pkg/ is in the same directory as this script.", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
