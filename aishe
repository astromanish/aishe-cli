# ─── Intent Lab ─────────────────────────────────────────────────────────────

def cmd_intent(args):
    if args.action == "stats":
        days = args.days or 7
        if not INTENT_DIR.exists():
            print(dim("No intent logs found.")); return
        now = datetime.now()
        total = 0
        by_intent = {}
        correct = 0
        misclassified = 0
        for f in INTENT_DIR.glob("intent_*.jsonl"):
            name = f.stem  # intent_YYYY-MM-DD
            date_str = name.replace("intent_", "")
            try:
                from datetime import date
                d = date.fromisoformat(date_str)
                days_ago = (now.date() - d).days
                if days_ago >= days: continue
            except: pass
            for line in f.read_text().splitlines():
                if not line.strip(): continue
                try:
                    e = json.loads(line)
                except: continue
                total += 1
                by_intent[e["intent"]] = by_intent.get(e["intent"], 0) + 1
                if e.get("feedback") is True: correct += 1
                elif e.get("feedback") is False: misclassified += 1
        accuracy = (correct / total * 100) if total > 0 else 0
        print(bold(f"Intent Stats (last {days} days)"))
        print("─" * 40)
        print(f"  Total:          {total}")
        print(f"  Accuracy:       {accuracy:.1f}%")
        print(f"  Misclassified:  {misclassified}")
        if by_intent:
            print(f"\n  {bold('By intent:')}")
            for intent, count in sorted(by_intent.items(), key=lambda x: -x[1]):
                bar = "█" * min(count, 30)
                print(f"    {intent:20s} {count:4d} {cyan(bar)}")
        return

    if args.action == "export":
        if not INTENT_DIR.exists():
            print(dim("No intent logs found.")); return
        outpath = os.path.expanduser(f"~/Downloads/intent_export_{datetime.now().strftime('%Y-%m-%d')}.csv")
        import csv
        with open(outpath, "w", newline="") as csvfile:
            w = csv.writer(csvfile)
            w.writerow(["id", "timestamp", "raw_text", "language", "intent", "confidence", "tool_used", "feedback"])
            for f in INTENT_DIR.glob("intent_*.jsonl"):
                for line in f.read_text().splitlines():
                    if not line.strip(): continue
                    try: e = json.loads(line)
                    except: continue
                    w.writerow([
                        e["id"], e["timestamp"], e["raw_text"], e["language"],
                        e["intent"], e["confidence"],
                        e.get("tool_used", ""),
                        "correct" if e.get("feedback") is True else "wrong" if e.get("feedback") is False else "",
                    ])
        print(f"{green('Exported')} → {outpath}")
        return

# ─── Live Voice I/O ─────────────────────────────────────────────────────────

def list_mic_devices():
    """List available AVFoundation audio input devices."""
    try:
        r = subprocess.run(
            ["ffmpeg", "-f", "avfoundation", "-list_devices", "true", "-i", ""],
            capture_output=True, text=True, timeout=5,
        )
        devices = []
        in_audio = False
        for line in (r.stdout + r.stderr).splitlines():
            if "AVFoundation audio devices:" in line:
                in_audio = True
                continue
            if in_audio and "[AVFoundation" in line and "audio" in line.lower():
                continue
            if in_audio and line.strip().startswith("["):
                import re
                m = re.search(r'\[(\d+)\]\s*(.+)', line.strip())
                if m:
                    devices.append((int(m.group(1)), m.group(2).strip()))
        return devices
    except:
        return []

def record_audio(duration, device_index, outpath):
    """Record audio from mic using ffmpeg."""
    cmd = [
        "ffmpeg", "-y",
        "-f", "avfoundation",
        "-i", f":{device_index}",
        "-t", str(duration),
        "-ar", "16000",
        "-ac", "1",
        outpath,
    ]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=duration + 5)
    return r.returncode == 0

def transcribe_file(filepath):
    """Transcribe a wav file via Parakeet STT."""
    with open(filepath, "rb") as f:
        resp = requests.post(
            f"{STT}/v1/audio/transcriptions",
            files={"file": (os.path.basename(filepath), f, "audio/wav")},
            data={"model": "parakeet-tdt-0.6b-v3"},
            timeout=30,
        )
    resp.raise_for_status()
    return resp.json().get("text", "").strip()

def synthesize_speak(text, voice="F4", play=True):
    """Synthesize speech via Supertonic TTS and optionally play it."""
    resp = requests.post(
        f"{TTS}/v1/audio/speech",
        json={"input": text, "voice": voice, "model": "supertonic-3", "response_format": "wav"},
        timeout=60,
    )
    resp.raise_for_status()
    outpath = f"/tmp/aishe_live_{uuid.uuid4().hex[:8]}.wav"
    with open(outpath, "wb") as f:
        f.write(resp.content)
    if play:
        subprocess.run(["afplay", outpath], capture_output=True)
        os.unlink(outpath)
    return outpath

def cmd_live(args):
    """Live voice conversation: record → STT → DeepAgent (streaming) → TTS → play, in a loop."""
    import threading
    import signal as sig_mod
    import time

    # Check services
    if not check(f"{STT}/healthz"):
        print(red("Parakeet STT is down on :5093")); sys.exit(1)
    if not check(f"{TTS}/health"):
        print(red("Supertonic TTS is down on :8766")); sys.exit(1)
    if not check(f"{DEEPAGENT}/health"):
        print(red("DeepAgent is down on :8765")); sys.exit(1)

    # Find mic device
    devices = list_mic_devices()
    if not devices:
        print(red("No microphone devices found")); sys.exit(1)

    # Auto-select or use specified device
    device_idx = args.device
    if device_idx is None:
        for idx, name in devices:
            if "macbook" in name.lower() or "built-in" in name.lower() or "microphone" in name.lower():
                device_idx = idx
                break
        if device_idx is None:
            device_idx = devices[0][0]

    # Print available devices
    print(bold("🎤 Live Voice Mode"))
    print(f"  Mic: {cyan(f'[{device_idx}]')} {dict(devices).get(device_idx, '?')}")
    print(f"  STT: {green('Parakeet :5093')}  TTS: {green('Supertonic :8766')}  LLM: {green('DeepAgent :8765')}")
    print(f"  Voice: {cyan(args.voice)}  Duration: {args.duration}s  Thread: {args.thread}")
    print()
    print(dim("Press Enter to record, Ctrl+C to exit."))
    print(dim("Or type a message and press Enter to chat without voice."))
    print("─" * 50)

    tid = args.thread or "live"
    consecutive_errors = 0

    while True:
        try:
            user_input = input(bold("\nYou ▶ ")).strip()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{dim('Goodbye!')}")
            break

        if not user_input:
            # Record from mic
            print(dim(f"  🔴 Recording {args.duration}s..."), end="", flush=True)
            recpath = f"/tmp/aishe_live_rec_{uuid.uuid4().hex[:8]}.wav"
            ok = record_audio(args.duration, device_idx, recpath)
            if not ok:
                print(f"\r  {red('Recording failed')}                    ")
                continue

            print(f"\r  {green('● Recorded')} → transcribing...", end="", flush=True)
            try:
                user_text = transcribe_file(recpath)
            except Exception as e:
                print(f"\r  {red(f'STT error: {e}')}                    ")
                os.unlink(recpath)
                consecutive_errors += 1
                if consecutive_errors >= 3:
                    print(red("Too many STT errors. Check Parakeet server."))
                    break
                continue
            finally:
                if os.path.exists(recpath):
                    os.unlink(recpath)

            if not user_text:
                print(f"\r  {yellow('(empty transcription)')}                    ")
                continue

            print(f"\r  {cyan('You said:')} {user_text}                    ")
            consecutive_errors = 0
        else:
            user_text = user_input

        # ── Stream from DeepAgent with full tool visibility ──
        print()
        try:
            r = requests.post(
                f"{DEEPAGENT}/stream",
                json={"message": user_text, "thread_id": tid},
                stream=True,
                timeout=120,
            )
            r.raise_for_status()
        except Exception as e:
            print(f"  {red(f'DeepAgent error: {e}')}")
            continue

        answer = ""
        tool_calls = []
        current_tool = None

        for line in r.iter_lines():
            if not line:
                continue
            try:
                ev = json.loads(line)
            except:
                continue

            etype = ev.get("event", "")

            if etype == "tool_call":
                name = ev.get("name", "?")
                args_str = json.dumps(ev.get("args", {}), ensure_ascii=False)
                current_tool = name
                tool_calls.append(name)
                print(f"  {yellow('⚡ tool_call')} {cyan(name)}({args_str})")

            elif etype == "tool_result":
                result = ev.get("result", "")
                result_short = result[:200] + ("..." if len(result) > 200 else "")
                print(f"  {dim('   └─ result:')} {result_short}")

            elif etype == "token":
                tok = ev.get("content", "")
                if tok:
                    print(tok, end="", flush=True)
                    answer += tok

            elif etype == "final":
                if not answer:
                    answer = ev.get("answer", "")

        if answer:
            print()

        if tool_calls:
            print(f"  {dim(f'└─ tools used: {", ".join(tool_calls)}')}")

        # TTS
        if not args.no_tts and answer.strip():
            print(f"  {dim('🔊 Speaking...')}", end="", flush=True)
            try:
                synthesize_speak(answer, voice=args.voice, play=True)
                print(f"\r  {green('🔊 Spoken')}                    ")
            except Exception as e:
                print(f"\r  {yellow(f'TTS failed: {e}')}                    ")

# ─── Main ──────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="aishe",
        description="Aishe CLI — voice-first AI for Bharat",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  aishe status
  aishe chat "What is 2+2?"
  aishe stream "Tell me a joke"
  aishe live                    — live voice conversation (press Enter to record)
  aishe live --list              — list mic devices
  aishe live -d 2 --duration 8  — use mic [2], record 8s per turn
  aishe live --no-tts           — voice input only, text responses
  aishe threads --new
  aishe memory add "User prefers Hindi"
  aishe memory search "Hindi"
  aishe voice transcribe recording.wav
  aishe voice speak "Namaste, main Aishe hoon"
  aishe ollama models
""",
    )
    sub = parser.add_subparsers(dest="command")

    # status
    sub.add_parser("status", help="Check all service statuses")

    # chat
    p_chat = sub.add_parser("chat", help="One-shot chat via DeepAgent")
    p_chat.add_argument("message", nargs="*", help="Message to send (or pipe via stdin)")
    p_chat.add_argument("-t", "--thread", default="cli", help="Thread ID")
    p_chat.add_argument("-v", "--verbose", action="store_true", help="Show tool calls")

    # stream
    p_stream = sub.add_parser("stream", help="Streaming chat (tokens printed live)")
    p_stream.add_argument("message", nargs="*", help="Message to send (or pipe via stdin)")
    p_stream.add_argument("-t", "--thread", default="cli", help="Thread ID")

    # threads
    p_threads = sub.add_parser("threads", help="Manage chat threads")
    p_threads.add_argument("--new", action="store_true", help="Create a new thread")
    p_threads.add_argument("--delete", metavar="ID", help="Delete a thread")
    p_threads.add_argument("--show", metavar="ID", help="Show thread messages")

    # memory
    p_mem = sub.add_parser("memory", help="Memory management")
    p_mem.add_argument("action", choices=["add", "search", "list", "clear"], help="Memory action")
    p_mem.add_argument("value", nargs="*", help="Fact text or search query")

    # voice
    p_voice = sub.add_parser("voice", help="Voice input/output")
    p_voice.add_argument("action", choices=["transcribe", "speak", "status"], help="Voice action")
    p_voice.add_argument("file", nargs="?", help="Audio file path (for transcribe)")
    p_voice.add_argument("text", nargs="*", help="Text to synthesize (for speak)")
    p_voice.add_argument("--voice", "-V", default="F4", help="Voice (F1-F5, M1-M5)")
    p_voice.add_argument("--output", "-o", help="Save audio to file (no auto-play)")
    p_voice.add_argument("--no-play", action="store_true", help="Don't auto-play audio")

    # ollama
    p_ollama = sub.add_parser("ollama", help="Ollama model management")
    p_ollama.add_argument("action", choices=["models", "pull", "whoami", "signin"], help="Ollama action")
    p_ollama.add_argument("model", nargs="?", help="Model name (for pull)")

    # intent
    p_intent = sub.add_parser("intent", help="Intent lab")
    p_intent.add_argument("action", choices=["stats", "export"], help="Intent action")
    p_intent.add_argument("--days", type=int, default=7, help="Days to include")

    # live
    p_live = sub.add_parser("live", help="Live voice conversation (record → STT → think → TTS)")
    p_live.add_argument("-d", "--device", type=int, default=None, help="Mic device index (use 'aishe live --list' to see)")
    p_live.add_argument("--duration", type=int, default=5, help="Recording duration in seconds")
    p_live.add_argument("-t", "--thread", default="live", help="Thread ID for conversation memory")
    p_live.add_argument("-V", "--voice", default="F4", help="TTS voice (F1-F5, M1-M5)")
    p_live.add_argument("--no-tts", action="store_true", help="Don't speak responses")
    p_live.add_argument("--list", action="store_true", help="List mic devices and exit")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    dispatch = {
        "status": cmd_status,
        "chat": cmd_chat,
        "stream": cmd_stream,
        "threads": cmd_threads,
        "memory": cmd_memory,
        "voice": cmd_voice,
        "ollama": cmd_ollama,
        "intent": cmd_intent,
        "live": cmd_live,
    }
    if args.command == "live" and hasattr(args, "list") and args.list:
        devices = list_mic_devices()
        if devices:
            print(bold("Available microphone devices:"))
            for idx, name in devices:
                print(f"  [{idx}] {name}")
            print(dim("\nUse: aishe live -d <index>"))
        else:
            print(red("No microphone devices found"))
        sys.exit(0)
    dispatch[args.command](args)

if __name__ == "__main__":
    main()