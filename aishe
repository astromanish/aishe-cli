#!/usr/bin/env python3
"""Aishe CLI — voice-first AI assistant for your terminal.

A standalone command-line AI assistant with voice input/output,
persistent memory, chat threads, tool calling, and live voice
conversation — all from your terminal.

Usage:
  aishe                        — interactive streaming chat (or one-shot with a message)
  aishe "hello"                — one-shot streaming chat
  aishe live                   — live voice conversation
  aishe status                 — check all services
  aishe doctor                 — run diagnostics
  aishe config                 — view/edit config
  aishe setup                  — choose your Ollama model + optional Telegram
  aishe telegram status        — Telegram bridge status
  aishe telegram auth <token>  — save bot token
  aishe gateway start|restart  — start/restart the Telegram bridge
  aishe version                — show version
  aishe memory add "fact"      — manage memory

Data lives in ~/aishe on every platform.
Requirements: Python 3.9+, requests (pip install requests)
"""

import os
import platform
import sys

# Platform-appropriate PATH additions
_system = platform.system()
if _system == "Darwin":
    # macOS: Homebrew paths
    os.environ["PATH"] = f"/opt/homebrew/bin:/usr/local/bin:{os.environ.get('PATH', '')}"
elif _system == "Windows":
    # Windows: add common Python Scripts paths
    scripts_dirs = [
        os.path.expanduser("~\\AppData\\Local\\Programs\\Python\\Python312\\Scripts"),
        os.path.expanduser("~\\AppData\\Roaming\\Python\\Python312\\Scripts"),
    ]
    for d in scripts_dirs:
        if os.path.isdir(d):
            os.environ["PATH"] = f"{d};{os.environ.get('PATH', '')}"
elif _system == "Linux":
    # Linux: add ~/.local/bin (common for pip --user installs)
    local_bin = os.path.expanduser("~/.local/bin")
    if os.path.isdir(local_bin):
        os.environ["PATH"] = f"{local_bin}:{os.environ.get('PATH', '')}"

# Resolve the real path of this script (follows symlinks)
script_path = os.path.realpath(os.path.abspath(__file__))
pkg_dir = os.path.join(os.path.dirname(script_path), "aishe_pkg")
if pkg_dir not in sys.path:
    sys.path.insert(0, os.path.dirname(pkg_dir))

# Suppress noisy urllib3 warning on older macOS Python
import warnings
warnings.filterwarnings("ignore", category=Warning, module="urllib3")
warnings.filterwarnings("ignore", message=".*NotOpenSSLWarning.*")

try:
    from aishe_pkg.cli import main
except ImportError as e:
    print(f"Error: Failed to load aishe package: {e}", file=sys.stderr)
    print("Make sure aishe_pkg/ is in the same directory as this script.", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
